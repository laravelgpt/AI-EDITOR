{
    "name": "ai-editor/ai-text-editor",
    "description": "Laravel 11+ AI-Powered Text Editor with Multi-Stack Support - Blade+Livewire, Vue.js SPA, React+Next.js",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "ai-editor", "text-editor", "ai", "blade", "livewire", "vue", "react", "nextjs", "spa", "multi-stack"],
    "authors": [
        {
            "name": "AI Editor Team",
            "email": "support@ai-editor.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0",
        "livewire/livewire": "^3.0",
        "spatie/laravel-permission": "^6.0",
        "spatie/laravel-activitylog": "^4.0",
        "laravel/breeze": "^2.0",
        "laravel/sanctum": "^4.0",
        "symfony/console": "^7.0",
        "symfony/process": "^7.0",
        "pusher/pusher-php-server": "^7.0",
        "intervention/image": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "orchestra/testbench": "^9.0",
        "mockery/mockery": "^1.6",
        "fakerphp/faker": "^1.23",
        "pestphp/pest": "^2.0",
        "pestphp/pest-plugin-laravel": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "AiEditor\\AiTextEditor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AiEditor\\AiTextEditor\\AiTextEditorServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
